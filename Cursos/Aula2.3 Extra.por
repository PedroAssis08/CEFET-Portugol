programa {
  funcao inicio() {
    
    inteiro mes

    escreva("Digite o número referente ao mês do seu aniversário: \n")
    leia(mes)

    escolha(mes){
      caso 1:
        escreva("o mês do seu anivêrsário é Janeiro")
        pare

      caso 2:
        escreva("o mês do seu anivêrsário é Feveiro")
        pare

      caso 3:
      escreva("o mês do seu anivêrsário é Março")
        pare

      caso 4:
      escreva("o mês do seu anivêrsário é Abril")
        pare

      caso 5:
      escreva("o mês do seu anivêrsário é Maio")
        pare

      caso 6:
      escreva("o mês do seu anivêrsário é Junho")
        pare

      caso 7:
      escreva("o mês do seu anivêrsário é Julho")
        pare

      caso 8:
      escreva("o mês do seu anivêrsário é Agosto")
        pare
      caso 9:
      escreva("o mês do seu anivêrsário é Setembro")
        pare

      caso 10:
      escreva("o mês do seu anivêrsário é Outubro")
        pare

      caso 11:
      escreva("o mês do seu anivêrsário é Novembro")
        pare

      caso 12:
      escreva("o mês do seu anivêrsário é Dezembro")
        pare

      caso contrario:
        escreva("Digite um número de 1 a 12:")

    }
  }
}

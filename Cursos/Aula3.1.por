programa {
  funcao inicio() {
    cadeia sigla

    escreva("Digte a sigla de um Estado: \n")
    leia(sigla)

    escolha(sigla){
      caso "RJ":
        escreva("O estado escolhido foi Rio de Janeiro")

      caso "SP":
        escreva("O estado escolhido foi São Paulo")

      caso "MG":
        escreva("O estado escolhido foi Minas Gerais")

      caso "ES":
        escreva("O estado escolhido foi Espírito Santo")
      
      caso "AC":
        escreva("O estado escolhido foi Acre")
      
      caso "AL":
        escreva("O estado escolhido foi Alagoas")

      caso "AP":
        escreva("O estado escolhido foi Amapá")
      
      caso "AM":
        escreva("O estado escolhido foi Amazonas")
      
      caso "BA":
        escreva("O estado escolhido foi Bahia")

      caso "CE":
        escreva("O estado escolhido foi Ceara")
      
      caso "DF":
        escreva("O estado escolhido foi Distrito Federal")
      
      caso "GO":
        escreva("O estado escolhido foi Goiás")

      caso "MA":
        escreva("O estado escolhido foi Maranhão")
      
      caso "MT":
        escreva("O estado escolhido foi Mato Grosso")
      
      caso "MS":
        escreva("O estado escolhido foi Mato Grosso do Sul")

      caso "PA":
        escreva("O estado escolhido foi Pará")
        
      caso "PB":
        escreva("O estado escolhido foi Paraíba")
        
      caso "PR":
        escreva("O estado escolhido foi Paraná")
        
      caso "PE":
        escreva("O estado escolhido foi Pernambuco")
        
      caso "PI":
        escreva("O estado escolhido foi Piauí")
        
      caso "RN":
        escreva("O estado escolhido foi Rio Grande do Norte")
        
      caso "RS":
        escreva("O estado escolhido foi Rio Grande do Sul")
        
      caso "RO":
        escreva("O estado escolhido foi Rondônia")
        
      caso "RR":
        escreva("O estado escolhido foi Roraima")
        
      caso "SC":
        escreva("O estado escolhido foi Santa Catarina")

      caso "SE":
        escreva("O estado escolhido foi Sergipe")
      
      caso "TO":
        escreva("O estado escolhido foi Tocantins")
        
    }
    
  }
}

programa {
  inclua biblioteca Util
  funcao inicio() {
    inteiro numero
    numero = Util.sorteia(1, 8)


    escolha(numero){
    caso 1:
    escreva("Você ganhou uma bola")
    pare


    caso 2:
    escreva("Você ganhou um play2")
    pare


    caso 3:
    escreva("Você ganhou 13.500 Vbuks no Fortnite")
    pare


    caso 4:
    escreva("Você ganhou um beyblade")
    pare


    caso 5:
    escreva("Você ganhou uma boneca")
    pare


    caso 6:
    escreva("Você ganhou uma massinha play-doh")
    pare


    caso 7:
    escreva("Você ganhou uma pipa")
    pare


    caso 8:
    escreva("Você não ganhou nada")
    pare
    }

  }
}

